{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Visibility Scorecard \u2014 verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "verifier",
    "date",
    "rubric_version",
    "audit_mode",
    "result",
    "query_universe_hash",
    "checks",
    "hard_failures",
    "soft_failures",
    "mutation_tests",
    "mutations",
    "fixture",
    "score",
    "word_count",
    "waivers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "audit_mode": {
      "const": "public"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "query_universe_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "soft_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "mutation_tests": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": true
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
