# Copy to .env only if your local tooling loads dotenv files.
# This repository never reads .env automatically. Export these in your shell.
# Never put a real value in this tracked file.

# DataForSEO API credentials (HTTP Basic Auth).
# Create or rotate them at https://app.dataforseo.com/api-access.
#
# Option A (recommended): separate login and password. The client encodes them.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
#
# Option B: a pre-encoded Base64 "login:password" value, with or without the
# "Basic " prefix. Base64 is not encryption; treat it as a credential.
# Leave blank unless you use it. Never put a real value in this tracked file.
# DATAFORSEO_BASIC_AUTH=

# Optional local safety controls (safe defaults are in code).
# LV_REQUEST_TIMEOUT_MS=15000
# LV_MAX_CONCURRENCY=4
# LV_MAX_RUN_COST_USD=
# LV_MAX_SERP_TASKS=
# LV_MAX_AI_TASKS=
